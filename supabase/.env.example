# Local Supabase variables. Copy to supabase/.env (git-ignored) and fill in; never commit values.
# Edge Functions: User-Agent sent to Open Food Facts (e.g. "AppFitness/0.1 (<contact email>)").
OFF_USER_AGENT=
# Google provider for the local stack (optional; empty values keep the stack starting).
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
