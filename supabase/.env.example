# Local Supabase variables. Copy to supabase/.env (git-ignored) and fill in; never commit values.
# Edge Functions: User-Agent sent to Open Food Facts (e.g. "AppFitness/0.1 (<contact email>)").
OFF_USER_AGENT=
# Google provider for the local stack (optional; empty values keep the stack starting).
# Web OAuth client ID (same value as the GOOGLE_WEB_CLIENT_ID repository secret; not secret).
GOOGLE_WEB_CLIENT_ID=
# Web OAuth client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Edge Functions: Google AI Studio key (free tier) used only by food-photo (ADR-59). Never commit a value.
GEMINI_API_KEY=
